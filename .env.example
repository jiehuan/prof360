# Copy to .env and fill in. Never commit .env.
SEC_USER_AGENT="Your Name your.email@example.com"
# DATABASE_URL=sqlite:///data/uw.db
# On the corporate network (D-040; values in config/azure.yaml):
# DATABASE_BACKEND=azure_sql   STORAGE_BACKEND=adls   AZURE_ENV=dv
# AZURE_SQL_CLIENT_ID=
# AZURE_SQL_CLIENT_SECRET=
# ADLS_CLIENT_ID=
# ADLS_CLIENT_SECRET=
# DATA_DIR=data
ALPHAVANTAGE_API_KEY=
# ALPHAVANTAGE_CALLS_PER_MINUTE=75   # premium plan
# ALPHAVANTAGE_DAILY_QUOTA=0         # 0 = unlimited
# LLM provider profile (config/llm.yaml): securegpt on the corporate network (default),
# anthropic for development and testing off it, runware for DeepSeek + Claude via Runware.
# LLM_PROVIDER=anthropic
SECUREGPT_CLIENT_ID=
SECUREGPT_CLIENT_SECRET=
SECUREGPT_SUBSCRIPTION_KEY=
# SECUREGPT_ENV=dv   # dv | pp | pr
# APP_DATABASE_URL=sqlite:///data/app.db
# Only when config/llm.yaml has provider: anthropic
ANTHROPIC_API_KEY=
# Required when the API key is not scoped to a workspace
# ANTHROPIC_WORKSPACE_ID=
# Only with LLM_PROVIDER=runware (account needs at least $5 credit)
RUNWARE_API_KEY=
# LLM_ENABLED=false   # rules only
