# Copy to .env and fill in. Never commit .env.
SEC_USER_AGENT="Your Name your.email@example.com"
# DATABASE_URL=sqlite:///data/uw.db
# On the corporate network (D-040; values in config/azure.yaml):
# DATABASE_BACKEND=azure_sql   STORAGE_BACKEND=adls   AZURE_ENV=dv
# Service principals; on Databricks leave them unset to read the secret scope named in
# config/azure.yaml (D-057).
# AZURE_SQL_CLIENT_ID=
# AZURE_SQL_CLIENT_SECRET=
# ADLS_CLIENT_ID=
# ADLS_CLIENT_SECRET=
# DATA_DIR=data
ALPHAVANTAGE_API_KEY=
# AV API key is required for both direct and apim modes.
# ALPHAVANTAGE_MODE=direct         # direct | apim; default direct
# ALPHAVANTAGE_ENV=dv              # default from config/alphavantage.yaml
# APIM additionally requires all three credentials (independent of SecureGPT):
# ALPHAVANTAGE_CLIENT_ID=
# ALPHAVANTAGE_CLIENT_SECRET=
# ALPHAVANTAGE_SUBSCRIPTION_KEY=
# ALPHAVANTAGE_CALLS_PER_MINUTE=75   # premium plan
# ALPHAVANTAGE_DAILY_QUOTA=0         # 0 = unlimited
# LLM: SecureGPT gateway (config/llm.yaml, config/securegpt.yaml)
SECUREGPT_CLIENT_ID=
SECUREGPT_CLIENT_SECRET=
SECUREGPT_SUBSCRIPTION_KEY=
# SECUREGPT_ENV=dv   # dv | pp | pr
# APP_DATABASE_URL=sqlite:///data/app.db
# LLM_ENABLED=false   # rules only

# Logging (D-089). LOG_FORMAT=json in the image. LOG_LEVEL=DEBUG brings back per-company detail.
# LOG_DIR: each run also writes a text log there (the image uses /data/logs), kept LOG_KEEP_DAYS.
# LOG_LEVEL=INFO
# LOG_DIR=data/logs
# LOG_KEEP_DAYS=30
